{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && auth.token.email_verified == true && root.child('allowedUsers').child(auth.uid).val() == true && $room.matches(/^[a-f0-9-]{36}$/)",
        "people": {
          ".write": "auth != null && auth.token.email_verified == true && root.child('allowedUsers').child(auth.uid).val() == true && $room.matches(/^[a-f0-9-]{36}$/)",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 == 0"
        },
        "events": {
          "$event": {
            ".write": "auth != null && auth.token.email_verified == true && root.child('allowedUsers').child(auth.uid).val() == true && $room.matches(/^[a-f0-9-]{36}$/)",
            ".validate": "newData.hasChildren(['title','date','category','start','end','cost','location','participants','notes','done'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^2027-03-0[5-8]$/)"
            },
            "category": {
              ".validate": "newData.isString() && (newData.val() == 'Paseo' || newData.val() == 'Comida' || newData.val() == 'Transporte' || newData.val() == 'Descanso' || newData.val() == 'Otro')"
            },
            "start": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "end": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/) && newData.val() > newData.parent().child('start').val()"
            },
            "cost": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "location": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "participants": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "notes": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "allowedUsers": {
      ".read": false,
      ".write": false
    }
  }
}
